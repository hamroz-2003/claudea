<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: bulutga zaxira va telefondan-telefonga ko'chirishda ilova ma'lumotlari OLINMAYDI.
     Sabab: IndexedDB ichida litsenziya kaliti, qurilma ID va Gemini API kaliti ochiq saqlanadi. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
