{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ryzon.uz/episode.schema.json",
  "title": "Ryzon Uz episode",
  "description": "Bitta epizodning to'liq tavsifi. Claude faqat shu JSONni yozadi; render kodi o'zgarmaydi.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "series",
    "pillar",
    "format",
    "title",
    "description",
    "tags",
    "logline",
    "cast",
    "thumbnail",
    "scenes"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60
    },
    "series": {
      "type": "string",
      "maxLength": 40,
      "description": "Masalan: NEVER AGAIN, THE CALL, DAY ZERO. Seriyasiz bo'lsa: STANDALONE"
    },
    "episodeNumber": {
      "type": "integer",
      "minimum": 1
    },
    "pillar": {
      "type": "string",
      "enum": [
        "addiction",
        "family",
        "loneliness",
        "discipline",
        "psychology"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "long",
        "short"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "en"
      ],
      "default": "en"
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 80,
      "maxLength": 4500,
      "description": "Vaqt belgilari (00:00) yozilmaydi — ular 'chapter' maydonlaridan avtomatik qo'shiladi"
    },
    "tags": {
      "type": "array",
      "minItems": 5,
      "maxItems": 25,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40
      }
    },
    "logline": {
      "type": "string",
      "maxLength": 300,
      "description": "Bir jumlada: kim, nima istaydi, nima to'sqinlik qiladi"
    },
    "realProblem": {
      "type": "string",
      "maxLength": 300,
      "description": "Hayotiy muammo va tomoshabin o'zini taniydigan aniq lahza"
    },
    "sensitive": {
      "type": "boolean",
      "default": false,
      "description": "Depressiya, o'z-o'ziga zarar, qaramlik kabi mavzular: tavsifga yordam manbalari qo'shiladi"
    },
    "cast": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "hoodie"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "maxLength": 30
          },
          "hoodie": {
            "type": "string",
            "enum": [
              "yellow",
              "grey",
              "red",
              "blue",
              "white",
              "green"
            ],
            "description": "Bosh qahramon (Ryzon) doim yellow"
          },
          "scale": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1.3,
            "default": 1
          }
        }
      }
    },
    "thumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "emotion",
        "environment"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 18,
          "description": "2-3 so'z, KATTA HARF. Sarlavhani takrorlamasin"
        },
        "subtext": {
          "type": "string",
          "maxLength": 24
        },
        "emotion": {
          "$ref": "#/definitions/emotion"
        },
        "environment": {
          "$ref": "#/definitions/environment"
        },
        "timeOfDay": {
          "$ref": "#/definitions/timeOfDay"
        },
        "accent": {
          "type": "string",
          "enum": [
            "yellow",
            "red",
            "white"
          ],
          "default": "yellow"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "beat",
          "durationSec",
          "environment",
          "camera",
          "characters"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "beat": {
            "type": "string",
            "enum": [
              "cold_open",
              "hook",
              "setup",
              "tension",
              "turn",
              "climax",
              "resolution",
              "cliffhanger",
              "cta"
            ]
          },
          "durationSec": {
            "type": "number",
            "minimum": 1.5,
            "maximum": 20
          },
          "environment": {
            "$ref": "#/definitions/environment"
          },
          "timeOfDay": {
            "$ref": "#/definitions/timeOfDay"
          },
          "camera": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "move"
            ],
            "properties": {
              "move": {
                "type": "string",
                "enum": [
                  "static",
                  "push_in",
                  "pull_out",
                  "orbit_left",
                  "orbit_right",
                  "pan_left",
                  "pan_right",
                  "crane_up",
                  "crane_down",
                  "shake"
                ]
              },
              "intensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.5
              }
            }
          },
          "characters": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "castId",
                "pose",
                "emotion"
              ],
              "properties": {
                "castId": {
                  "type": "string"
                },
                "pose": {
                  "type": "string",
                  "enum": [
                    "stand",
                    "walk",
                    "run",
                    "sit",
                    "slump",
                    "reach",
                    "kneel",
                    "lie",
                    "hug",
                    "look_phone",
                    "head_in_hands"
                  ]
                },
                "emotion": {
                  "$ref": "#/definitions/emotion"
                },
                "x": {
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 0.95,
                  "default": 0.5
                },
                "toX": {
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 0.95,
                  "description": "walk/run uchun yakuniy nuqta"
                },
                "facing": {
                  "type": "string",
                  "enum": [
                    "left",
                    "right"
                  ],
                  "default": "right"
                }
              }
            }
          },
          "props": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/definitions/prop"
            }
          },
          "caption": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "style"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 90
              },
              "style": {
                "type": "string",
                "enum": [
                  "title",
                  "thought",
                  "counter",
                  "whisper",
                  "message"
                ]
              }
            }
          },
          "sfx": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "#/definitions/sfx"
            }
          },
          "music": {
            "type": "string",
            "enum": [
              "none",
              "pad_low",
              "pad_hope",
              "pulse"
            ],
            "default": "pad_low"
          },
          "transition": {
            "type": "string",
            "enum": [
              "cut",
              "fade",
              "flash",
              "blackout"
            ],
            "default": "cut"
          },
          "notes": {
            "type": "string",
            "maxLength": 200,
            "description": "Inson muharriri uchun izoh (renderga ta'sir qilmaydi)"
          },
          "chapter": {
            "type": "string",
            "maxLength": 40,
            "description": "Shu sahnadan yangi YouTube bo'limi boshlanadi. Vaqtni kod o'zi hisoblaydi; tavsifga vaqt belgisi YOZILMAYDI"
          }
        }
      }
    },
    "shortScenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 20,
      "items": {
        "type": "string"
      },
      "description": "Shorts (1080x1920) uchun sahna id'lari tartibi; jami 20-58 s. Eng kuchli zarba + savol bilan tugasin"
    }
  },
  "definitions": {
    "emotion": {
      "type": "string",
      "enum": [
        "neutral",
        "sad",
        "anxious",
        "angry",
        "happy",
        "tired",
        "shocked",
        "determined",
        "ashamed",
        "hopeful"
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "bedroom",
        "office",
        "kitchen",
        "street",
        "bus_stop",
        "rooftop",
        "hospital",
        "void",
        "living_room",
        "casino",
        "park",
        "classroom"
      ]
    },
    "timeOfDay": {
      "type": "string",
      "enum": [
        "night",
        "day",
        "dusk",
        "dawn"
      ]
    },
    "prop": {
      "type": "string",
      "enum": [
        "phone",
        "clock",
        "door",
        "bed",
        "desk",
        "laptop",
        "window",
        "bottle",
        "calendar",
        "chair",
        "sofa",
        "tv",
        "lamp",
        "streetlight",
        "bench",
        "slot_machine",
        "cards",
        "photo_frame",
        "hospital_bed",
        "car"
      ]
    },
    "sfx": {
      "type": "string",
      "enum": [
        "clock_tick",
        "hum",
        "footsteps",
        "ui_click",
        "heartbeat",
        "rain",
        "door",
        "notification",
        "wind",
        "crowd"
      ]
    }
  }
}
