# Google OAuth (Desktop app) — Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/oauth2callback
YOUTUBE_REFRESH_TOKEN=

# review = private yuklash + Telegramga tasdiq so'rovi (TAVSIYA)
# schedule = private + publishAt (faqat API audit o'tgandan keyin ishlaydi)
YOUTUBE_PUBLISH_MODE=review
# schedule rejimida: necha soatdan keyin chiqsin va soat nechada (UTC)
YOUTUBE_PUBLISH_HOUR_UTC=13
YOUTUBE_CATEGORY_ID=1

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ixtiyoriy: claude yo'li va modeli
CLAUDE_BIN=claude
CLAUDE_MODEL=
# GPU'siz kompyuter/serverda: swangle
REMOTION_GL=angle
